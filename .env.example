# Vercel Postgres (Neon) — Vercel Marketplace-аас Neon нэмэхэд автоматаар үүснэ
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Vercel Blob — Storage → Blob store үүсгэхэд автоматаар үүснэ
BLOB_READ_WRITE_TOKEN=

# Auth.js — `npx auth secret` эсвэл `openssl rand -base64 32`
AUTH_SECRET=

# Google Cloud Vertex AI — доорх аргуудын аль нэг нь хангалттай
VERTEX_PROJECT=my-gcp-project
VERTEX_LOCATION=us-central1
# (1) Vertex AI API түлхүүр (express mode) — хамгийн хялбар, Vercel-д тохиромжтой
VERTEX_API_KEY=
# (2) Service account JSON-ийг нэг мөрөөр (Vercel)
GOOGLE_SERVICE_ACCOUNT_KEY=
# (3) Service account файлын зам (зөвхөн локал)
VERTEX_CREDENTIALS=
# Хоосон бол gcloud application-default credentials ашиглана.
# Gemini 1.5 загварууд Google дээр зогссон тул анхдагчаар 2.5-ийг ашиглана.
GEMINI_MODEL=gemini-2.5-flash
