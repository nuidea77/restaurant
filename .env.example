# Vercel → Project → Settings → Environment Variables (Production, Preview, Development бүгдэд).
# Локал хөгжүүлэлтэд: `vercel env pull .env.local`

# Neon (Postgres) — Vercel → Storage → Neon холбоход автоматаар нэмэгдэнэ
DATABASE_URL=
# Vercel Blob — Vercel → Storage → Blob холбоход автоматаар нэмэгдэнэ
BLOB_READ_WRITE_TOKEN=

# Нэвтрэлтийн нууц түлхүүр (`openssl rand -base64 32`)
AUTH_SECRET=

# Google Cloud Vertex AI (цэсийг AI-аар унших)
VERTEX_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# (эсвэл service account) VERTEX_PROJECT=, VERTEX_LOCATION=us-central1, GOOGLE_SERVICE_ACCOUNT_KEY={...нэг мөр JSON}

# Byl.mn төлбөр — хоосон бол туршилтын (demo) төлбөр
BYL_TOKEN=
BYL_PROJECT_ID=
BYL_WEBHOOK_SECRET=

# verify.mn утас баталгаажуулалт — хоосон бол туршилтын горим
VERIFY_MN_API_KEY=

# Заавал биш
# APP_URL=https://таны-домэйн.mn   (Byl/verify.mn буцах хаяг; хоосон бол хүсэлтээс авна)
# DEMO_DATA=false                  (хоосон өгөгдлийн санд демо ресторан оруулахгүй)
