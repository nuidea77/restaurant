# Энэ файлыг .env.local нэрээр хуулж, утгуудыг бөглөнө.
# Өгөгдлийн сан, файлууд ./data хавтаст автоматаар үүснэ — өөр тохиргоо хэрэггүй.

# Google Cloud Vertex AI (цэсийг AI-аар унших) — доорх аргуудын аль нэг нь хангалттай
# (1) Vertex AI API түлхүүр — хамгийн хялбар
VERTEX_API_KEY=
# (2) Service account JSON файлын зам + project
VERTEX_CREDENTIALS=
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1

GEMINI_MODEL=gemini-2.5-flash

# Заавал биш: нэвтрэлтийн нууц түлхүүр. Хоосон бол data/.auth-secret-д автоматаар үүснэ.
AUTH_SECRET=
# Заавал биш: өгөгдөл хадгалах хавтас (анхдагч: ./data)
DATA_DIR=
# Заавал биш: хоосон өгөгдлийн санд демо 10 ресторан автоматаар оруулахгүй байх бол false
DEMO_DATA=

# Byl.mn төлбөр (https://byl.mn/docs/en/api/) — хоосон бол туршилтын (demo) төлбөр ажиллана.
# Dashboard → Settings → API tokens
BYL_TOKEN=
# Project settings хуудсанд харагдах дугаар
BYL_PROJECT_ID=
# Dashboard → Webhooks → endpoint → Signing secret (зөвхөн интернэтэд гарсан үед хэрэгтэй)
BYL_WEBHOOK_SECRET=
# Заавал биш: апп-ын нийтийн хаяг (Byl-ээс буцах хаяг). Хоосон бол хүсэлтийн хаягаас авна.
APP_URL=

# verify.mn — утасны дугаар баталгаажуулалт (https://verify.mn). Хоосон бол туршилтын горим.
# verify.mn → Нэвтрэх → API KEY (vrf_...)
VERIFY_MN_API_KEY=
