# Энэ файлыг .env.local нэрээр хуулж, утгуудыг бөглөнө.
# Өгөгдлийн сан, файлууд ./data хавтаст автоматаар үүснэ — өөр тохиргоо хэрэггүй.

# Google Cloud Vertex AI (цэсийг AI-аар унших) — доорх аргуудын аль нэг нь хангалттай
# (1) Vertex AI API түлхүүр — хамгийн хялбар
VERTEX_API_KEY=
# (2) Service account JSON файлын зам + project
VERTEX_CREDENTIALS=
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1

GEMINI_MODEL=gemini-2.5-flash

# Заавал биш: нэвтрэлтийн нууц түлхүүр. Хоосон бол data/.auth-secret-д автоматаар үүснэ.
AUTH_SECRET=
# Заавал биш: өгөгдөл хадгалах хавтас (анхдагч: ./data)
DATA_DIR=
