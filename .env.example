# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud Vertex AI
GOOGLE_CLOUD_PROJECT=my-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
# Vercel дээр service account-ийн JSON түлхүүрийг нэг мөрөөр оруулна.
# Локал орчинд хоосон үлдээвэл Application Default Credentials (gcloud auth) ашиглана.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Gemini 1.5 загварууд Google дээр зогссон тул анхдагчаар 2.5-ийг ашиглана.
GEMINI_MODEL=gemini-2.5-flash
